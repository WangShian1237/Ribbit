# --- 依赖（各子项目）---
node_modules/

# --- 环境变量与密钥（*.example 可提交，勿提交真实 .env）---
.env
.env.local
.env.*.local

# --- 构建产物 ---
dist/
build/
out/

# --- 工具缓存 ---
.vite/
.cache/
.turbo/
*.tsbuildinfo

# --- 日志与调试 ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 测试覆盖率 ---
coverage/
.nyc_output/

# --- 系统与编辑器（根目录；client/.gitignore 另有前端细化规则）---
.DS_Store
Thumbs.db
Desktop.ini
.idea/

# --- 本地证书或私钥（若放在仓库内）---
*.pem
*.key

# --- 本地数据 / 旧版导入（含密码哈希等，勿提交）---
server/data/*.json
